# ---------------------------------------------------------------------------
# MERDN - Valores de entorno FICTICIOS para la base de pruebas AISLADA
# (Spec 025 "baseline de pruebas aislada", paquete MP01-C2)
#
# Este archivo es una PLANTILLA versionada. No contiene ningun secreto real:
# todas las claves son marcadores `reemplazar-por-...` sin valor utilizable.
#
# Uso previsto: copiar a un archivo local ignorado por Git, sustituir cada
# marcador por un valor efimero y validar de forma declarativa con
#
#   docker compose -f compose.test.yml --env-file <archivo-local> config
#
# La credencial administrativa y la credencial de runtime son DISTINTAS y con
# permisos distintos. La credencial administrativa solo existe dentro del cluster
# desechable, para crear y migrar. La credencial de runtime es la unica que
# llegaria al proceso de la aplicacion, y nunca es propietaria ni superusuario.
# ---------------------------------------------------------------------------

# --- Identidad de arranque del cluster de pruebas (uso interno del cluster) ---
POSTGRES_DB=merdn_test
POSTGRES_USER=merdn_test_admin
POSTGRES_PASSWORD=reemplazar-por-clave-ficticia-admin

# --- Identidad de runtime de la aplicacion (sin ownership, sin bypass) -------
MERDN_RUNTIME_DB_USER=merdn_runtime
MERDN_RUNTIME_DB_PASSWORD=reemplazar-por-clave-ficticia-runtime
MERDN_RUNTIME_ROLE=enforce

# --- Direcciones: deliberadamente distintas, mismo cluster y misma base ------
# Administrativa: creacion, migraciones y fixtures dentro del cluster de pruebas.
TEST_DATABASE_ADMIN_URL=postgresql://merdn_test_admin:reemplazar-por-clave-ficticia-admin@127.0.0.1:55432/merdn_test?schema=public
# Runtime: unica direccion que el proceso de la aplicacion llegaria a usar.
TEST_DATABASE_RUNTIME_URL=postgresql://merdn_runtime:reemplazar-por-clave-ficticia-runtime@127.0.0.1:55432/merdn_test?schema=public
