# PLACEHOLDERS ONLY. Copy outside the repository and chmod 600/root-only.
# Ningun valor real vive aqui: todos contienen `REPLACE` y el preflight falla
# cerrado mientras siga presente.
MERDN_STAGING_DOMAIN=staging.example.invalid
MERDN_OIDC_DOMAIN=identity-staging.example.invalid
MERDN_API_IMAGE=registry.example.invalid/merdn-api@sha256:REPLACE_WITH_DIGEST
MERDN_WEB_IMAGE=registry.example.invalid/merdn-web@sha256:REPLACE_WITH_DIGEST
MERDN_OIDC_IMAGE=quay.io/keycloak/keycloak@sha256:REPLACE_WITH_DIGEST

# Contacto ACME obligatorio del borde TLS. Sin fallback `off`: si falta o sigue
# siendo el marcador, el preflight detiene el despliegue.
MERDN_TLS_CONTACT_EMAIL=REPLACE_TLS_CONTACT@example.invalid

POSTGRES_DB=merdn_staging
POSTGRES_USER=merdn_migrator
POSTGRES_PASSWORD=REPLACE-fictitious-not-a-secret
DATABASE_URL=postgresql://merdn_migrator:REPLACE-fictitious-not-a-secret@postgres:5432/merdn_staging?schema=public
RUNTIME_DATABASE_URL=postgresql://merdn_runtime:REPLACE-different-fictitious-not-a-secret@postgres:5432/merdn_staging?schema=public
MERDN_RUNTIME_ROLE=enforce
MERDN_ACTIVE_TENANT_CODE=fictional-staging-tenant
# UUID del MISMO tenant, leido con la credencial migradora despues de cargar los
# datos de referencia. Obligatorio bajo enforce; el preflight falla cerrado
# mientras siga el marcador o no tenga forma de UUID canonico.
MERDN_ACTIVE_TENANT_ID=REPLACE_WITH_TENANT_UUID

# Identidad de base de datos aislada de Keycloak. El bootstrap
# (`infra/staging/init/10-keycloak-database.sh`) y el runtime de Keycloak
# consumen EXACTAMENTE estas tres variables: no pueden divergir.
MERDN_OIDC_DATABASE_NAME=merdn_oidc
MERDN_OIDC_DATABASE_USER=merdn_oidc
MERDN_OIDC_DATABASE_PASSWORD=REPLACE-fictitious-not-a-secret
MERDN_OIDC_ADMIN_USER=REPLACE_ADMIN_NAME
MERDN_OIDC_ADMIN_PASSWORD=REPLACE-fictitious-not-a-secret
MERDN_OIDC_REALM=merdn-staging
MERDN_HUMAN_AUTH_CLIENT_ID=merdn-human-web
MERDN_HUMAN_AUTH_ATTEMPT_KEY=REPLACE_32_BYTE_SECRET
