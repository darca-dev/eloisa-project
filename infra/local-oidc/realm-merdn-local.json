{
  "realm": "merdn-local",
  "enabled": true,
  "displayName": "Eloisa",
  "loginTheme": "eloisa",
  "internationalizationEnabled": true,
  "defaultLocale": "es",
  "supportedLocales": ["es"],
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,

  "clients": [
    {
      "clientId": "merdn-human-web",
      "name": "MERDN - acceso humano (local)",
      "description": "Cliente publico con PKCE S256 obligatorio. Sin secreto. Sin comodines en redirect ni en web origin. Direct Access Grants DESACTIVADO: el unico camino es Authorization Code.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://127.0.0.1:3001/api/v1/human-auth/callback"],
      "webOrigins": ["http://127.0.0.1:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3000/",
        "access.token.signed.response.alg": "RS256",
        "id.token.signed.response.alg": "RS256"
      }
    },
    {
      "clientId": "merdn-access-provisioning",
      "name": "MERDN - provision de cuentas (local)",
      "description": "Cliente CONFIDENCIAL de servicio (SPEC 038 MP04). Solo obtiene token administrativo por client_credentials para aprovisionar cuentas ficticias en este realm. Sin Authorization Code ni Direct Access Grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "secret": "${MERDN_ACCESS_PROVISIONING_CLIENT_SECRET}"
    }
  ],

  "users": [
    {
      "id": "00000000-0000-4000-8000-00000000f1c7",
      "username": "persona.ficticia",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Persona",
      "lastName": "Ficticia",
      "email": "persona.ficticia@ejemplo.invalid",
      "credentials": [
        {
          "type": "password",
          "temporary": false,
          "value": "${MERDN_OIDC_LOCAL_TEST_PASSWORD}"
        }
      ],
      "realmRoles": [],
      "clientRoles": {}
    },
    {
      "id": "00000000-0000-4000-8000-00000000f1c8",
      "username": "persona.sin.vinculo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Persona",
      "lastName": "SinVinculo",
      "email": "persona.sin.vinculo@ejemplo.invalid",
      "credentials": [
        {
          "type": "password",
          "temporary": false,
          "value": "${MERDN_OIDC_LOCAL_TEST_PASSWORD}"
        }
      ],
      "realmRoles": [],
      "clientRoles": {}
    },
    {
      "id": "00000000-0000-4000-8000-00000000f1c9",
      "username": "service-account-merdn-access-provisioning",
      "serviceAccountClientId": "merdn-access-provisioning",
      "enabled": true,
      "emailVerified": true,
      "firstName": "service",
      "lastName": "account",
      "realmRoles": [],
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
